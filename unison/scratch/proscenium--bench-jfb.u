{{ One row of the js-framework-benchmark table for stock Proscenium, with the reference markup (`keyed/vanillajs`): {bench.rows.rowView} with the glyph the suite clicks to remove a row. }}
bench.jfbstock.rowView : ((Model -> Model) ->{Update} ()) -> Boolean -> Row ->{Render g} ()
bench.jfbstock.rowView updateModel isSelected row =
  use Render text
  rowId = Row.id row
  region rowId do
    tr [class (if isSelected then "danger" else "")] do
      td [class "col-md-1"] do text (Nat.toText rowId)
      td [class "col-md-4"] do
        a [class "lbl", onClick do updateModel (Model.selected.set (Some rowId))] do text (Row.label row)
      td [class "col-md-1"] do
        a [class "remove", onClick do updateModel (Model.remove rowId)] do
          element "span" [class "remove glyphicon glyphicon-remove", attribute "aria-hidden" "true"] do ()
      td [class "col-md-6"] do ()

{{ One of the suite's action buttons, in its column, applying `change` to the model. }}
bench.jfbstock.actionButton : ((Model -> Model) ->{Update} ()) -> Text -> Text -> (Model -> Model) ->{Render g} ()
bench.jfbstock.actionButton updateModel buttonId label change =
  el.div [class "col-sm-6 smallpad"] do
    button [attr.id buttonId, class "btn btn-primary btn-block", attribute "type" "button", onClick do updateModel change] do Render.text label

{{ The js-framework-benchmark app for stock Proscenium: {bench.rows.ui}'s model in one `useState`, a keyed region per row, and the suite's reference markup. }}
bench.jfbstock.ui : '{Render {}} ()
bench.jfbstock.ui = do
  (model, updateModel) = useState do Model.initial
  setModel : (Model -> Model) ->{Update} ()
  setModel change = updateModel change
  actionButton = bench.jfbstock.actionButton setModel
  el.div [class "container"] do
    el.div [class "jumbotron"] do
      el.div [class "row"] do
        el.div [class "col-md-6"] do
          element "h1" [] do Render.text "Proscenium-keyed"
        el.div [class "col-md-6"] do
          el.div [class "row"] do
            actionButton "run" "Create 1,000 rows" (Model.create 1000)
            actionButton "runlots" "Create 10,000 rows" (Model.create 10000)
            actionButton "add" "Append 1,000 rows" (Model.append 1000)
            actionButton "update" "Update every 10th row" Model.updateEveryTenth
            actionButton "clear" "Clear" (Model.rows.set [])
            actionButton "swaprows" "Swap Rows" Model.swapRows
    el.table [class "table table-hover table-striped test-data"] do
      tbody [attr.id "tbody"] do
        selected = Model.selected model
        Model.rows model |> List.foreach (row -> bench.jfbstock.rowView setModel (selected === Some (Row.id row)) row)
    element "span" [class "preloadicon glyphicon glyphicon-remove", attribute "aria-hidden" "true"] do ()

bench.jfbstock.build : '{IO, Exception} ()
bench.jfbstock.build = bench.build.run "jfb" bench.jfbstock.ui
