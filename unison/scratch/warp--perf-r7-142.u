tests.builtins : [WasmTest]
tests.builtins =
  List.map
    (WasmTest.group "builtins")
    [ universal
    , builtins.list
    , builtins.nat
    , builtins.int
    , builtins.float
    , builtins.natural
    , integer
    , builtins.bytes
    , builtins.char
    , builtins.text
    , builtins.pattern
    , charClass
    , textPatterns
    , immutableByteArray
    , mutableByteArray
    , immutableArray
    , mutableArray
    ]

ReleaseNotes : Doc
ReleaseNotes =
  {{
  * Further hardened {Universal.compare} against edge cases in bare function
    and closure comparison.
  * 2026-10-30: `Text` counts code points, as Unison does, rather than UTF-16
    units. `Text.size`, `Text.take`, `Text.drop`, `Text.uncons`,
    `Text.unsnoc`, `Text.reverse`, `Text.toCharList` and `Text.indexOf` treat
    a character outside the Basic Multilingual Plane, such as an emoji, as one
    character, and never split it into half a surrogate pair. A text
    pattern's character class matches one code point.
  * 2026-10-30: `Text` and `Char` are ordered by code point, as Unison orders
    them, in {Universal.compare}, in `Text.<` and its siblings, and in a
    `match` on text literals. That `match` binary-searches literals sorted by
    Unison's order, and could miss an arm whose literal was outside the Basic
    Multilingual Plane.
  * 2026-10-30: `tests.builtins.textFuzz` runs 1,800 pseudo-random text
    operations natively and in Wasm and fails on the first difference.
  * 2026-10-30: JS builtins can take their arguments unboxed and box their
    results in wasm ({internal.Replacement.jsUnboxed}), so the JS function
    makes no calls back into wasm. The `JSValue` interop functions
    (`invoke*`, `getProperty`, `setProperty*`, `callback1_`), `Nat.toText`
    and `Text.indexOf` use it. A UI creating 1,000 table rows crossed the
    wasm–JS boundary 197,231 times before and 32,046 after.
  * 2026-10-30: `Universal.==` compares a plain function with a closure by
    id in wasm instead of in JS.
  * 2026-10-30: `Universal.compare`, `Universal.==` and the builtins with a
    `Boolean` result return shared result boxes
    ({internal.Replacement.sharedValues}) instead of allocating one per call.
  * 2026-10-30: `Text.size`, `Text.take` and `Text.drop` run in wasm over the
    `wasm:js-string` builtins (`length`, `substring`), with no call into JS.
  * 2026-10-30: `Char.toText`, `Char.toNat`, `Char.fromNat`, `Text.uncons` and
    `Text.unsnoc` also run in wasm over `wasm:js-string`.
  * 2026-10-30: `Text.repeat` and `Text.reverse` run in wasm too.
  * 2026-10-28: `Universal.compare` and `Universal.==` compare values of the
    same kind in wasm ({Universal_compare.defineCompareValues},
    {Universal_eq.defineEqValues}), and fall back to JS for the rest.
  * 2026-10-29: `List` is a balanced tree of 32-element arrays in wasm
    instead of a JS finger tree, with a differential test of 9,000 random
    list operations against the native runtime (`tests.builtins.listFuzz`).
  * 2026-10-29: `JSValue.getProperty`, `setProperty`, `setPropertyText`,
    `invoke0`, `invoke0_`, `invoke1_`, `invokeText1`, `invokeText1_`,
    `invokeText2`, `invokeText2_`, `invokeText3_`, `invokeTextVal_` and
    `callback1_` call a JS method or property in one step.
  }}

{{
Whether the UTF-16 units of `text` at `index` and `index + 1` are a surrogate pair, one code point outside the Basic Multilingual Plane: `1` or `0` on the stack. `index` is a local holding the position, and `size` the text's length, so no unit past the end is read. `back` asks instead about the units at `index - 1` and `index - 2`, read from the end.
}}
internal.runtime.replacements.unison_base.Text_size.pairAt : FuncReference -> LocalIdx -> LocalIdx -> LocalIdx -> Boolean ->{ExprCtx} ()
internal.runtime.replacements.unison_base.Text_size.pairAt charCodeAt text index size back =
  unitIs offset kind =
    local.get text
    local.get index
    if offset Int.< +0 then
      i32.const (Int.abs offset)
      i32.sub()
    else
      i32.const (Int.abs offset)
      i32.add()
    instr.call charCodeAt
    i32.const 64512
    i32.and()
    i32.const kind
    i32.eq()
  if back then
    local.get index
    i32.const 2
    i32.ltS()
  else
    local.get index
    i32.const 1
    i32.add()
    local.get size
    i32.geS()
  pair _ =
    if back then
      unitIs -1 56320
      unitIs -2 55296
    else
      unitIs +0 55296
      unitIs +1 56320
    i32.and()
  ifThenElse.withResult i32 (_ -> i32.const 0) pair

{{ `Text.size` for warp's output, in wasm: the number of code points, as Unison counts them. It is the text's UTF-16 `length` less one for each surrogate pair, counted with `charCodeAt`. }}
internal.runtime.replacements.unison_base.Text_size : Replacement
internal.runtime.replacements.unison_base.Text_size = wasmExpression 1 cases
  runtime ->
    use func *
    length = import.func "wasm:js-string" "length" (param externref => result i32)
    charCodeAt = import.func "wasm:js-string" "charCodeAt" (param externref * param i32 => result i32)
    cases
      env, vars ->
        text = FuncCtx.local externref
        size = FuncCtx.local i32
        index = FuncCtx.local i32
        count = FuncCtx.local i32
        pair = FuncCtx.local i32
        pushTag VNat
        env' = pushUnboxedVar VText env (List.unsafeAt 0 vars)
        local.tee text
        instr.call length
        local.tee size
        local.set count
        i32.const 0
        local.set index
        block cases
          exit ->
            instr.loop cases
              again ->
                local.get index
                local.get size
                i32.geS()
                brIf exit
                Text_size.pairAt charCodeAt text index size false
                local.set pair
                local.get count
                local.get pair
                i32.sub()
                local.set count
                local.get index
                i32.const 1
                i32.add()
                local.get pair
                i32.add()
                local.set index
                br again
        local.get count
        i64.extendI32U()
        struct.new (Runtime.valueType VNat runtime)
        env'

{{
`Text.take` and `Text.drop` for warp's output, in wasm: the first `n` code points, or all but them, over the `wasm:js-string` builtins. A count at least the text's UTF-16 length takes or drops it all at once; otherwise the offset is found by stepping over `n` code points, two units for a surrogate pair.

`textSlice keepFront` builds one of them: `true` keeps the first `n`, `false` drops them.
}}
internal.runtime.replacements.unison_base.Text_take.textSlice : Boolean -> Replacement
internal.runtime.replacements.unison_base.Text_take.textSlice keepFront = wasmExpression 2 cases
  runtime ->
    use func *
    length = import.func "wasm:js-string" "length" (param externref => result i32)
    charCodeAt = import.func "wasm:js-string" "charCodeAt" (param externref * param i32 => result i32)
    substring = import.func "wasm:js-string" "substring" (param externref * param i32 * param i32 => result (abs.ref extern))
    cases
      env, vars ->
        count = FuncCtx.local (VN I64)
        text = FuncCtx.local externref
        size = FuncCtx.local i32
        offset = FuncCtx.local i32
        remaining = FuncCtx.local i32
        pushTag VText
        env1 = pushUnboxedVar VNat env (List.unsafeAt 0 vars)
        local.set count
        env2 = pushUnboxedVar VText env1 (List.unsafeAt 1 vars)
        local.tee text
        instr.call length
        local.tee size
        local.set offset
        block cases
          done ->
            local.get count
            local.get size
            i64.extendI32U()
            i64.geU()
            brIf done
            local.get count
            i32.wrapI64()
            local.set remaining
            i32.const 0
            local.set offset
            instr.loop cases
              again ->
                local.get remaining
                i32.eqz()
                brIf done
                local.get offset
                local.get size
                i32.geS()
                brIf done
                local.get offset
                i32.const 1
                i32.add()
                Text_size.pairAt charCodeAt text offset size false
                i32.add()
                local.set offset
                local.get remaining
                i32.const 1
                i32.sub()
                local.set remaining
                br again
        local.get text
        if keepFront then
          i32.const 0
          local.get offset
        else
          local.get offset
          local.get size
        instr.call substring
        struct.new (Runtime.valueType VText runtime)
        env2

internal.runtime.replacements.unison_base.Text_take : Replacement
internal.runtime.replacements.unison_base.Text_take = Text_take.textSlice true

internal.runtime.replacements.unison_base.Text_drop : Replacement
internal.runtime.replacements.unison_base.Text_drop = Text_take.textSlice false

{{
`Text.uncons` and `Text.unsnoc` for warp's output, in wasm: the `wasm:js-string` `length`, `charCodeAt` and `substring` builtins, with the `Optional` and the pair built in wasm (`None` is one shared box). Both split off one code point: two UTF-16 units when they are a surrogate pair.
}}
internal.runtime.replacements.unison_base.Text_uncons.textSplit : Boolean -> Replacement
internal.runtime.replacements.unison_base.Text_uncons.textSplit fromFront = wasmExpression 1 cases
  runtime ->
    use func *
    length = import.func "wasm:js-string" "length" (param externref => result i32)
    charCodeAt = import.func "wasm:js-string" "charCodeAt" (param externref * param i32 => result i32)
    substring = import.func "wasm:js-string" "substring" (param externref * param i32 * param i32 => result (abs.ref extern))
    anyValueRef = Runtime.internalRef InternalType.Value runtime
    valuesType = Runtime.internalType Values runtime
    dataType = Runtime.valueType VData runtime
    (optionalID, someCtor) = constructorGlobal (termLink Optional.Some)
    (_, noneCtor) = constructorGlobal (termLink Optional.None)
    (tupleID, consCtor) = constructorGlobal (termLink Tuple.Cons)
    (unitID, unitCtor) = constructorGlobal (termLink Unit)
    shared ctorID ctor = def.global (global.const anyValueRef) do
      pushTag VData
      global.get ctorID
      i32.const ctor
      newFixed valuesType 0
      struct.new dataType
    none = shared optionalID noneCtor
    unit = shared unitID unitCtor
    cases
      env, vars ->
        text = FuncCtx.local externref
        size = FuncCtx.local i32
        position = FuncCtx.local i32
        cut = FuncCtx.local i32
        env' = pushUnboxedVar VText env (List.unsafeAt 0 vars)
        local.tee text
        instr.call length
        local.tee size
        i32.eqz()
        piece ty start end =
          pushTag ty
          local.get text
          start()
          end()
          instr.call substring
          struct.new (Runtime.valueType ty runtime)
        zero _ = i32.const 0
        whole _ = local.get size
        atCut _ = local.get cut
        pair first second =
          pushTag VData
          global.get tupleID
          i32.const consCtor
          first()
          pushTag VData
          global.get tupleID
          i32.const consCtor
          second()
          global.get unit
          newFixed valuesType 2
          struct.new dataType
          newFixed valuesType 2
          struct.new dataType
        split _ =
          if fromFront then
            i32.const 0
            local.set position
            i32.const 1
            Text_size.pairAt charCodeAt text position size false
            i32.add()
            local.set cut
          else
            local.get size
            local.set position
            local.get size
            i32.const 1
            Text_size.pairAt charCodeAt text position size true
            i32.add()
            i32.sub()
            local.set cut
          pushTag VData
          global.get optionalID
          i32.const someCtor
          if fromFront then pair (_ -> piece VChar zero atCut) (_ -> piece VText atCut whole)
          else pair (_ -> piece VText zero atCut) (_ -> piece VChar atCut whole)
          newFixed valuesType 1
          struct.new dataType
        ifThenElse.withResult anyValueRef (_ -> global.get none) split
        env'

internal.runtime.replacements.unison_base.Text_uncons : Replacement
internal.runtime.replacements.unison_base.Text_uncons = Text_uncons.textSplit true

internal.runtime.replacements.unison_base.Text_unsnoc : Replacement
internal.runtime.replacements.unison_base.Text_unsnoc = Text_uncons.textSplit false

{{ `Text.reverse` for warp's output, in wasm: a loop from the end over `charCodeAt`, taking one code point at a time with `substring` (both units of a surrogate pair together) and joining them with `concat`. }}
internal.runtime.replacements.unison_base.Text_reverse : Replacement
internal.runtime.replacements.unison_base.Text_reverse = wasmExpression 1 cases
  runtime ->
    use func *
    length = import.func "wasm:js-string" "length" (param externref => result i32)
    charCodeAt = import.func "wasm:js-string" "charCodeAt" (param externref * param i32 => result i32)
    substring = import.func "wasm:js-string" "substring" (param externref * param i32 * param i32 => result (abs.ref extern))
    concat = import.func "wasm:js-string" "concat" (param externref * param externref => result (abs.ref extern))
    emptyText = stringGlobal ""
    cases
      env, vars ->
        text = FuncCtx.local externref
        size = FuncCtx.local i32
        index = FuncCtx.local i32
        start = FuncCtx.local i32
        reversed = FuncCtx.local externref
        pushTag VText
        env' = pushUnboxedVar VText env (List.unsafeAt 0 vars)
        local.tee text
        instr.call length
        local.tee size
        local.set index
        global.get emptyText
        local.set reversed
        block cases
          exit ->
            instr.loop cases
              again ->
                local.get index
                i32.eqz()
                brIf exit
                local.get index
                i32.const 1
                Text_size.pairAt charCodeAt text index size true
                i32.add()
                i32.sub()
                local.set start
                local.get reversed
                local.get text
                local.get start
                local.get index
                instr.call substring
                instr.call concat
                local.set reversed
                local.get start
                local.set index
                br again
        local.get reversed
        asNonNull()
        struct.new (Runtime.valueType VText runtime)
        env'

{{ `Text.indexOf` for warp's output: an unboxed JS call to `indexOf`, with the `Optional` built in wasm. The UTF-16 index JS finds is turned into a count of code points, as Unison counts them. }}
internal.runtime.replacements.unison_base.Text_indexOf : Replacement
internal.runtime.replacements.unison_base.Text_indexOf =
  src =
    """
    (rt, needle, haystack) => {
      let index = haystack.indexOf(needle);
      if (index < 0) return -1n;
      let n = index;
      for (let i = 0; i + 1 < index; i++) {
        if ((haystack.charCodeAt(i) & 0xFC00) === 0xD800 && (haystack.charCodeAt(i + 1) & 0xFC00) === 0xDC00) { n--; i++; }
      }
      return BigInt(n);
    }
    """
  builder name runtime =
    use Text ++
    externRef = abs.ref extern
    anyValueRef = Runtime.internalRef InternalType.Value runtime
    valuesType = Runtime.internalType Values runtime
    dataType = Runtime.valueType VData runtime
    rt = import.global "runtime" "self" (global.const externRef)
    jsIndexOf = import.func.named ("js." ++ humanReadableID name) "js" (refToWasmID name) (func.Signature.Signature [(None, externRef), (None, externRef), (None, externRef)] [VN I64] ())
    (optionalID, someCtor) = constructorGlobal (termLink Optional.Some)
    (_, noneCtor) = constructorGlobal (termLink Optional.None)
    none = def.global (global.const anyValueRef) do
      pushTag VData
      global.get optionalID
      i32.const noneCtor
      newFixed valuesType 0
      struct.new dataType
    textArg index =
      getDirectArg index runtime
      ref.cast (Runtime.valueRef VText runtime)
      struct.get (Runtime.valueType VText runtime) 1
    defDirectFunc name runtime 2 do
      found = FuncCtx.local (VN I64)
      global.get rt
      textArg 0
      textArg 1
      instr.call jsIndexOf
      local.tee found
      i64.const 0
      i64.ltS()
      atIndex _ =
        pushTag VData
        global.get optionalID
        i32.const someCtor
        pushTag VNat
        local.get found
        struct.new (Runtime.valueType VNat runtime)
        newFixed valuesType 1
        struct.new dataType
      ifThenElse.withResult anyValueRef (_ -> global.get none) atIndex
  NativeTerm (SigDirect 2) (Some src) builder

{{ A small linear congruential generator, so the native and Wasm sides draw the same operations. }}
tests.builtins.textFuzz.lcg : Nat -> Nat
tests.builtins.textFuzz.lcg s = Nat.mod ((s Nat.* 1103515245) Nat.+ 12345) 2147483648

tests.builtins.textFuzz.cat : [Text] -> Text
tests.builtins.textFuzz.cat = Text.join ""

tests.builtins.textFuzz.cmp : a -> a -> Text
tests.builtins.textFuzz.cmp x y = match Universal.compare x y with
  +0 -> "EQ"
  i | i Int.< +0 -> "LT"
  _ -> "GT"

tests.builtins.textFuzz.boolText : Boolean -> Text
tests.builtins.textFuzz.boolText b = if b then "T" else "F"

tests.builtins.textFuzz.optNat : Optional Nat -> Text
tests.builtins.textFuzz.optNat = cases
  Some n -> Nat.toText n
  None -> "none"

{{ The first line where two traces differ, with both versions of it (`<end>` where one trace is shorter). }}
tests.builtins.textFuzz.firstDiff : [Text] -> [Text] -> Optional (Nat, Text, Text)
tests.builtins.textFuzz.firstDiff xs ys =
  use Nat +
  go i = match (List.at i xs, List.at i ys) with
    (None, None) -> None
    (Some x, Some y) | x Text.== y -> go (i + 1)
    (x, y) -> Some (i, Optional.getOrElse "<end>" x, Optional.getOrElse "<end>" y)
  go 0

{{ A text by its UTF-8 bytes: how many, a hash of all of them, and the first six in hex. A line then says which code points a text holds, and a lone surrogate (which UTF-8 cannot hold) shows up as the replacement character's bytes. }}
tests.builtins.textFuzz.bytesOf : Text -> Text
tests.builtins.textFuzz.bytesOf t =
  bytes = unison_base_7_15_0.Bytes.toList (Text.toUtf8 t)
  hex b = Nat.toTextBase 16 b |> Optional.getOrElse "?"
  hash = List.foldLeft (acc b -> Nat.mod ((acc Nat.* 31) Nat.+ b) 1000000007) 7 bytes
  tests.builtins.textFuzz.cat ["u8#", Nat.toText (List.size bytes), "h", Nat.toText hash, "[", Text.join " " (List.map hex (List.take 6 bytes)), "]"]

{{ A list of code points, as numbers. }}
tests.builtins.textFuzz.codes : [Char] -> Text
tests.builtins.textFuzz.codes chars = "[" Text.++ Text.join "," (List.map (c -> Nat.toText (Char.toNat c)) chars) Text.++ "]"

{{ Texts the fuzz draws from: ASCII, two- and three-byte UTF-8, characters outside the Basic Multilingual Plane (written in JS as two UTF-16 units), a combining mark, a skin-tone modifier, and U+FF61, which sorts above every surrogate in UTF-16 but below the astral characters by code point. }}
tests.builtins.textFuzz.seeds : [Text]
tests.builtins.textFuzz.seeds =
  [ ""
  , "abc"
  , "héllo wörld"
  , "日本語のテキスト"
  , "a😀b"
  , "👍🏽 ok"
  , "é"
  , "｡x"
  , "𝔘𝔫𝔦𝔠𝔬𝔡𝔢 text"
  , "😀😀😀"
  ]

{{ A `match` on text literals, which warp compiles to a binary search over the literals sorted by Unison's order. The literals mix ASCII, U+FF61 and characters outside the Basic Multilingual Plane, whose order differs between code points and UTF-16 units. }}
tests.builtins.textFuzz.arm : Text -> Nat
tests.builtins.textFuzz.arm = cases
  "a" -> 1
  "｡" -> 2
  "😀" -> 3
  "é" -> 4
  "𝔘" -> 5
  "｡x" -> 6
  "a😀b" -> 7
  "👍" -> 8
  _ -> 0

{{ Code points the fuzz appends: ASCII, Latin-1, a CJK character, U+FF61, and three outside the Basic Multilingual Plane. }}
tests.builtins.textFuzz.points : [Nat]
tests.builtins.textFuzz.points = [65, 233, 26085, 65377, 128512, 119828, 127997]

{{ One text operation, picked by `op`: sizes, slices (`take`, `drop`, `uncons`, `unsnoc`), `reverse`, char lists both ways, `++`, `indexOf`, `compare` and `==`, `repeat`, `split`, case changes, UTF-8 round trips, appending a code point, a pattern capturing two characters, and a `match` on text literals ({tests.builtins.textFuzz.arm}). Each step returns the text that replaces `a` in the pool and a line describing the result. }}
tests.builtins.textFuzz.step : Nat -> Text -> Text -> Nat ->{Exception} (Text, Text)
tests.builtins.textFuzz.step op a b r =
  use Nat + mod toText
  use Text ++
  use tests.builtins.textFuzz cat cmp boolText optNat
  bytesOf = tests.builtins.textFuzz.bytesOf
  codes = tests.builtins.textFuzz.codes
  na = Text.size a
  match op with
    0 -> (a, cat ["size ", toText na, " ", toText (Text.size b)])
    1 ->
      n = mod r (na + 3)
      (Text.take n a, cat ["take ", toText n])
    2 ->
      n = mod r (na + 3)
      (Text.drop n a, cat ["drop ", toText n])
    3 -> match Text.uncons a with
      Some (c, rest) -> (rest, cat ["uncons ", toText (Char.toNat c)])
      None -> (a, "uncons none")
    4 -> match Text.unsnoc a with
      Some (rest, c) -> (rest, cat ["unsnoc ", toText (Char.toNat c)])
      None -> (a, "unsnoc none")
    5 -> (Text.reverse a, "reverse")
    6 -> (a, cat ["chars ", codes (Text.toCharList a)])
    7 -> (Text.fromCharList (List.reverse (Text.toCharList a)), "fromCharList reversed")
    8 -> (a ++ b, "append")
    9 ->
      i = mod r (na + 1)
      j = mod (r / 7) 4
      needle = Text.take j (Text.drop i a)
      (a, cat ["indexOf ", bytesOf needle, " ", optNat (Text.indexOf needle a)])
    10 -> (a, cat ["cmp ", cmp a b, " eq ", boolText (a Text.== b), " lt ", boolText (a Text.< b)])
    11 ->
      k = mod r 4
      (Text.repeat k a, cat ["repeat ", toText k])
    12 ->
      parts = Text.split ?\s a
      (Text.join "_" parts, cat ["split ", toText (List.size parts)])
    13 -> (Text.toUppercase a, "upper")
    14 -> (Text.toLowercase a, "lower")
    15 -> match Text.fromUtf8.impl (Text.toUtf8 a) with
      Right t -> (t, cat ["utf8 ", boolText (t Text.== a)])
      Left _ -> (a, "utf8 failed")
    16 ->
      code = List.at (mod r (List.size tests.builtins.textFuzz.points)) tests.builtins.textFuzz.points |> Optional.getOrElse 65
      match Char.fromNat code with
        Some c -> (a ++ Char.toText c, cat ["snoc ", toText code])
        None -> (a, cat ["snoc invalid ", toText code])
    17 ->
      two = Pattern.capture (Pattern.replicate 2 2 Text.patterns.anyChar)
      match Pattern.run two a with
        Some (captured, rest) -> (rest, cat ["pattern ", bytesOf (Text.join "|" captured)])
        None -> (a, "pattern none")
    18 ->
      i = mod r (na + 2)
      (a, cat ["at ", toText i, " ", bytesOf (Text.take 1 (Text.drop i a))])
    19 -> (a, cat ["arm ", toText (tests.builtins.textFuzz.arm (Text.take 1 a)), " ", toText (tests.builtins.textFuzz.arm a)])
    _ ->
      seed = List.at (mod r (List.size tests.builtins.textFuzz.seeds)) tests.builtins.textFuzz.seeds |> Optional.getOrElse ""
      (seed, "seed")

{{ Applies `steps` pseudo-random text operations ({tests.builtins.textFuzz.step}) to a pool of eight texts, starting from `seed`, and describes each result by its UTF-8 bytes. Texts longer than 60 characters are cut back so a trace stays small. }}
tests.builtins.textFuzz.trace : Nat -> Nat ->{Exception} [Text]
tests.builtins.textFuzz.trace seed steps =
  use Nat + mod toText ==
  use List :+
  use tests.builtins.textFuzz cat lcg
  go i s pool out =
    if i == steps then out
    else
      s1 = lcg s
      s2 = lcg s1
      s3 = lcg s2
      s4 = lcg s3
      op = mod (s1 / 7) 21
      ai = mod (s2 / 3) 8
      bi = mod (s3 / 5) 8
      a = List.at ai pool |> Optional.getOrElse ""
      b = List.at bi pool |> Optional.getOrElse ""
      (res, line) = tests.builtins.textFuzz.step op a b (s4 / 11)
      res' = if Text.size res Nat.> 60 then Text.take 60 res else res
      pool' = List.replace ai res' pool
      go (i + 1) s4 pool' (out :+ cat [toText i, " op", toText op, " ", line, " => ", tests.builtins.textFuzz.bytesOf res'])
  go 0 seed (List.take 8 tests.builtins.textFuzz.seeds) []

{{
Runs the same {tests.builtins.textFuzz.trace} natively and in Wasm. Unison's `Text` counts code points, so this catches any builtin that works in UTF-16 units instead.

The Wasm side sends its trace over the test channel. The native side compares it with its own, prints the first line where they differ, and sends that line back. The Wasm side then fails if it got one. A failure is raised in Wasm because the harness reports one there, while a failure on the native side of a channel test leaves the harness waiting.
}}
tests.builtins.textFuzz : Nat -> Nat -> WasmTest
tests.builtins.textFuzz seed steps =
  use tests.builtins.textFuzz cat
  host = do
    lines = tests.builtins.textFuzz.trace seed steps
    other = receiveValue()
    verdict = match tests.builtins.textFuzz.firstDiff lines (Text.split ?\n other) with
      None -> ""
      Some (i, native, wasm) -> cat ["line ", Nat.toText i, "\n  native: ", native, "\n  wasm:   ", wasm]
    if verdict Text.== "" then () else printLine (cat ["text fuzz ", Nat.toText seed, " differs at ", verdict])
    sendValue verdict
  wasm = do
    sendValue (Text.join "\n" (tests.builtins.textFuzz.trace seed steps))
    test.ensureEqual "" (receiveValue())
  wasmTestWithChannel (cat ["text fuzz ", Nat.toText seed]) host wasm

{{ {tests.builtins.textFuzz} from three seeds, 600 operations each. }}
tests.builtins.textFuzz.suite : '{IO, Exception} [Result]
tests.builtins.textFuzz.suite = do WasmTest.run [tests.builtins.textFuzz 42 600, tests.builtins.textFuzz 7 600, tests.builtins.textFuzz 1234 600]

{{ A short {tests.builtins.textFuzz}, for a first look. }}
tests.builtins.textFuzz.short : '{IO, Exception} [Result]
tests.builtins.textFuzz.short = do WasmTest.run [tests.builtins.textFuzz 42 40]

{{ `Text.toCharList` for warp's output: one `Char` per code point, in a wasm list. }}
internal.runtime.replacements.unison_base.Text_toCharList : Replacement
internal.runtime.replacements.unison_base.Text_toCharList =
  src =
    """
    (rt, text) => {
      let chars = Array.from(rt.Text_getValue(text), c => rt.Char(c));
      return rt.js.listFromArray(rt, chars);
    }
    """
  jsFunction 1 src

{{ warp's JS pattern engine. A character class matches one code point, so it consumes both units of a surrogate pair, and a lookbehind looks at the whole code point before the position. Positions stay UTF-16 offsets inside the engine; captures and the rest are slices at code point boundaries. }}
internal.javascript.supportJS.patternJS : Text
internal.javascript.supportJS.patternJS =
  """
  class Pattern {
    constructor(matcher) {
      this.run = matcher;
    }

    static width(text, index) {
      return index + 1 < text.length && (text.charCodeAt(index) & 0xFC00) === 0xD800 && (text.charCodeAt(index + 1) & 0xFC00) === 0xDC00 ? 2 : 1;
    }

    static before(text, index) {
      return index >= 2 && (text.charCodeAt(index - 1) & 0xFC00) === 0xDC00 && (text.charCodeAt(index - 2) & 0xFC00) === 0xD800 ? text.slice(index - 2, index) : text.slice(index - 1, index);
    }

    static charClass(regex) {
      return new Pattern((text, index) => {
        if (index >= text.length) return null;
        let char = text.slice(index, index + Pattern.width(text, index));
        let result = regex.exec(char);
        if (result) {
          return { captures: [], index: index + char.length };
        } else {
          return null;
        }
      });
    }

    static literal(text) {
      return new Pattern((input, index) => {
        if (input.slice(index).startsWith(text)) {
          return { captures: [], index: index + text.length };
        } else {
          return null;
        }
      });
    }

    static join(patterns) {
      return new Pattern((text, index) => {
        let captures = [];
        for (let pattern of patterns) {
          let result = pattern.run(text, index);
          if (result === null) return null;
          captures.push(...result.captures);
          index = result.index;
        }
        return { captures, index };
      });
    }

    static capture(pattern) {
      return new Pattern((text, index) => {
        let result = pattern.run(text, index);
        if (result === null) return null;
        let captures = [text.slice(index, result.index), ...result.captures];
        return { captures, index: result.index };
      });
    }

    static captureAs(as, pattern) {
      return new Pattern((text, index) => {
        let result = pattern.run(text, index);
        if (result === null) return null;
        let captures = [as, ...result.captures];
        return { captures, index: result.index };
      });
    }

    static lookahead(pattern) {
      return new Pattern((text, index) => {
        let result = pattern.run(text, index);
        if (result === null) return null;
        return { captures: [], index };
      });
    }

    static negativeLookahead(pattern) {
      return new Pattern((text, index) => {
        let result = pattern.run(text, index);
        if (result !== null) return null;
        return { captures: [], index };
      });
    }

    static lookbehind(regex) {
      return new Pattern((text, index) => {
        if (regex.test(Pattern.before(text, index))) {
          return { captures: [], index };
        } else {
          return null;
        }
      });
    }

    static negativeLookbehind(regex) {
      return new Pattern((text, index) => {
        if (!regex.test(Pattern.before(text, index))) {
          return { captures: [], index };
        } else {
          return null;
        }
      });
    }

    static many(pattern) {
      return new Pattern((text, index) => {
        let captures = [];
        while (true) {
          let result = pattern.run(text, index);
          if (result === null) break;
          captures.push(...result.captures);
          index = result.index;
        }
        return { captures, index };
      });
    }

    static replicate(n, m, pattern) {
      return new Pattern((text, index) => {
        let captures = [];
        let count = 0;
        while (count < m) {
          let result = pattern.run(text, index);
          if (result === null) break;
          captures.push(...result.captures);
          index = result.index;
          count++;
        }
        if (count < n) return null;
        return { captures, index };
      });
    }

    static or(a, b) {
      return new Pattern((text, index) => {
        let resultA = a.run(text, index);
        if (resultA !== null) return resultA;
        return b.run(text, index);
      });
    }

    static eof() {
      return new Pattern((text, index) => {
        if (index >= text.length) {
          return { captures: [], index };
        } else {
          return null;
        }
      });
    }
  }
  """

{{
`Text.<`, `Text.>`, `Text.<=` and `Text.>=` for warp's output, in wasm: {internal.runtime.Helper.CompareStrings}, which orders by code point as Unison does, rather than the `wasm:js-string` `compare` builtin, which orders by UTF-16 unit.

`textOrder test` builds one of them: `test` turns the order (`-1`, `0` or `1`, on the stack) into the Boolean.
}}
internal.runtime.replacements.unison_base.Text_lt.textOrder : '{ExprCtx} () -> Replacement
internal.runtime.replacements.unison_base.Text_lt.textOrder test = wasmExpression 2 cases
  runtime -> cases
    env, vars ->
      pushTag VBoolean
      env' = List.foldLeft (pushUnboxedVar VText) env vars
      instr.call (Runtime.helper CompareStrings runtime)
      test()
      struct.new (Runtime.valueType VBoolean runtime)
      env'

{{
warp's string comparison, used by text `match`es (which binary-search their literals, sorted by Unison's order when the module is built), by `Universal.compare` and by `Text.<` and its siblings. It orders by code point, as Unison does. The `wasm:js-string` `compare` builtin it replaces orders by UTF-16 unit, which puts a character outside the Basic Multilingual Plane (a surrogate pair, from 0xD800) below U+E000 to U+FFFF. A `match` then missed an arm whose literal was outside the plane when another arm's literal was in that range.

The two strings are walked with `charCodeAt` to their first difference, where surrogates are moved above U+E000 to U+FFFF. A string that is a prefix of the other comes first.
}}
internal.runtime.Helper.CompareStrings.define : Types ->{TypeCtx, ModuleCtx} FuncReference
internal.runtime.Helper.CompareStrings.define types =
  use func *
  use local get named set
  length = import.func "wasm:js-string" "length" (param externref => result i32)
  charCodeAt = import.func "wasm:js-string" "charCodeAt" (param externref * param i32 => result i32)
  compareStrings = def.func (CompareStrings.signature types) cases
    (a, b) ->
      x = named "x" i32
      y = named "y" i32
      common = named "common" i32
      index = named "index" i32
      order = named "order" i32
      sign _ =
        get x
        get y
        i32.gtS()
        get x
        get y
        i32.ltS()
        i32.sub()
        set order
      codePointOrder unit =
        get unit
        i32.const 8192
        i32.add()
        get unit
        i32.const 2048
        i32.sub()
        get unit
        i32.const 57344
        i32.ltS()
        select.numeric()
        get unit
        get unit
        i32.const 55296
        i32.geS()
        select.numeric()
        set unit
      get a
      instr.call length
      set x
      get b
      instr.call length
      set y
      sign()
      get x
      get y
      get x
      get y
      i32.ltS()
      select.numeric()
      set common
      i32.const 0
      set index
      block cases
        exit ->
          instr.loop cases
            again ->
              get index
              get common
              i32.geS()
              brIf exit
              block cases
                same ->
                  get a
                  get index
                  instr.call charCodeAt
                  set x
                  get b
                  get index
                  instr.call charCodeAt
                  set y
                  get x
                  get y
                  i32.eq()
                  brIf same
                  codePointOrder x
                  codePointOrder y
                  sign()
                  br exit
              get index
              i32.const 1
              i32.add()
              set index
              br again
      get order
  export.func "compareStrings" compareStrings
  compareStrings

internal.runtime.replacements.unison_base.Text_lt : Replacement
internal.runtime.replacements.unison_base.Text_lt = Text_lt.textOrder do
  i32.const (Int.toRepresentation -1)
  i32.eq()

internal.runtime.replacements.unison_base.Text_gt : Replacement
internal.runtime.replacements.unison_base.Text_gt = Text_lt.textOrder do
  i32.const 1
  i32.eq()

internal.runtime.replacements.unison_base.Text_lte : Replacement
internal.runtime.replacements.unison_base.Text_lte = Text_lt.textOrder do
  i32.const 1
  i32.ltS()

internal.runtime.replacements.unison_base.Text_gte : Replacement
internal.runtime.replacements.unison_base.Text_gte = Text_lt.textOrder do
  i32.const (Int.toRepresentation -1)
  i32.gtS()
