{{ One row of the js-framework-benchmark table, with the reference markup (`keyed/vanillajs`): its label and selection are its own state, as in {bench.rowsfg.rowView}, and the remove link holds the glyph the suite clicks. }}
bench.jfb.rowView : ((bench.rowsfg.Model ->{Rows} bench.rowsfg.Model) ->{Update} ()) -> Nat ->{Render {Rows}} ()
bench.jfb.rowView setModel rowId =
  use Render text
  region rowId do
    elementWith "tr" do
      label = useKeyed labels rowId |> Optional.getOrElse ""
      isSelected = useSelected selection rowId
      td [class "col-md-1"] do text (Nat.toText rowId)
      td [class "col-md-4"] do
        a [class "lbl", onClick do Selector.select selection (Some rowId)] do text label
      td [class "col-md-1"] do
        a [class "remove", onClick do setModel (bench.rowsfg.Model.ids.modify (List.filter (id -> id Nat.!= rowId)))] do
          element "span" [class "remove glyphicon glyphicon-remove", attribute "aria-hidden" "true"] do ()
      td [class "col-md-6"] do ()
      [class (if isSelected then "danger" else "")]

{{ One of the suite's action buttons, in its column. }}
bench.jfb.actionButton : Text -> Text -> '{Rows, Update} () ->{Render {Rows}} ()
bench.jfb.actionButton buttonId label handler =
  el.div [class "col-sm-6 smallpad"] do
    button [attr.id buttonId, class "btn btn-primary btn-block", attribute "type" "button", onClick handler] do Render.text label

{{ The js-framework-benchmark app (`frameworks/keyed/proscenium`): {bench.rowsfg.ui}'s model, stores and actions, with the suite's reference markup, rendered into `#main`. }}
bench.jfb.ui : '{Rows, Render {Rows}} ()
bench.jfb.ui = do
  (model, updateModel) = useState do bench.rowsfg.Model.initial
  setModel : (bench.rowsfg.Model ->{Rows} bench.rowsfg.Model) ->{Update} ()
  setModel change = updateModel change
  el.div [class "container"] do
    el.div [class "jumbotron"] do
      el.div [class "row"] do
        el.div [class "col-md-6"] do
          element "h1" [] do Render.text "Proscenium-keyed"
        el.div [class "col-md-6"] do
          el.div [class "row"] do
            bench.jfb.actionButton "run" "Create 1,000 rows" do replaceWith setModel model 1000
            bench.jfb.actionButton "runlots" "Create 10,000 rows" do replaceWith setModel model 10000
            bench.jfb.actionButton "add" "Append 1,000 rows" do bench.rowsfg.append setModel model
            bench.jfb.actionButton "update" "Update every 10th row" do updateEveryTenth model
            bench.jfb.actionButton "clear" "Clear" do bench.rowsfg.clear setModel
            bench.jfb.actionButton "swaprows" "Swap Rows" do setModel (bench.rowsfg.Model.ids.modify swapIds)
    el.table [class "table table-hover table-striped test-data"] do
      tbody [attr.id "tbody"] do bench.rowsfg.Model.ids model |> List.foreach (bench.jfb.rowView setModel)
    element "span" [class "preloadicon glyphicon glyphicon-remove", attribute "aria-hidden" "true"] do ()

{{ `run bench.jfb.build <bare|debug> <outDir>`: the js-framework-benchmark app's module and loader, mounting {bench.jfb.ui} into the page's `#main`, timed by phase. }}
bench.jfb.build : '{IO, Exception} ()
bench.jfb.build = do
  use Text ++
  mountMain _ = mount (JSValue.invokeText1 "getElementById" "main" (global "document")) bench.rowsfg.provider bench.jfb.ui
  match getArgs() with
    [configName, outDir] ->
      match configs configName with
        Some config -> report ("jfb-" ++ configName) (FilePath outDir) (withPhaseTimes do warp.withProgressEvents config do exposeFunction_ "main" mountMain)
        None -> printLine ("unknown config: " ++ configName)
    _ -> printLine "usage: <bare|debug> <outDir>"

{{ Formats `count` numbers spread over the range of `Nat` and counts how many came out as `"0"`, so that each call's text is used. }}
bench.totext.loop : Nat -> Nat
bench.totext.loop count =
  use Nat * + ==
  go index found =
    if index == count then found
    else
      text = Nat.toText (index * 2654435761)
      go (index + 1) (if text Text.== "0" then found + 1 else found)
  go 0 0

{{ `run bench.totext.build <bare|debug> <outDir>`: a module whose `main` formats a million numbers with `Nat.toText`, for timing a builtin's implementation from JS. }}
bench.totext.build : '{IO, Exception} ()
bench.totext.build = do
  use Text ++
  runLoop _ = ignore (bench.totext.loop 1000000)
  match getArgs() with
    [configName, outDir] ->
      match configs configName with
        Some config -> report ("totext-" ++ configName) (FilePath outDir) (withPhaseTimes do warp.withProgressEvents config do exposeFunction_ "main" runLoop)
        None -> printLine ("unknown config: " ++ configName)
    _ -> printLine "usage: <bare|debug> <outDir>"

{{ The recipe search: an input that never reads its own value, a count, and the matching recipes, keyed by catalog index. The query is the search's own state. The filter runs inside the `#search` element's body, which ink skips when the query, the catalog and the listener are unchanged, so a re-render of the page for anything else does not filter again, as the Leptos twin's `Memo` does not. (A `region` is not a skip boundary: its body runs with its parent's.) }}
bench.meals.searchView : '{Render {Flip}} ()
bench.meals.searchView = do
  use Nat toText
  use Render text
  use Text ++
  region "search" do
    recipes = useMemo catalog
    (query, updateQuery) = useState do ""
    setQuery : (Text ->{Flip} Text) ->{Update} ()
    setQuery change = updateQuery change
    result : (Recipe, Nat) ->{Render {Flip}} ()
    result = cases
      (recipe, index) ->
        region index do
          element "li" [class "result"] do
            span [class "name"] do text (Recipe.name recipe)
            span [class "kcal"] do text (toText (Recipe.kcal recipe) ++ " kcal")
            button [class "add"] do text "Add"
    onQuery : Text ->{Flip, Update} ()
    onQuery value = setQuery (_ -> value)
    queryListener : Modifier {Flip}
    queryListener = Render.on "input" (Extractor.at "target" (Extractor.at "value" Extractor.text)) onQuery
    el.div [attr.id "search"] do
      results = List.indexed recipes |> List.filter (cases (recipe, _) -> Text.contains query (Recipe.name recipe))
      voidElement "input" [attr.id "search-input", attribute "type" "search", queryListener]
      element "p" [attr.id "search-note"] do
        text ("Showing " ++ toText (List.size results) ++ " of " ++ toText (List.size recipes) ++ " for \"" ++ query ++ "\"")
      element "ul" [attr.id "results"] do List.foreach result results
