{{
A computation's previous children, as one re-run looks them up.

Most re-runs produce their children in the order the last run did, give or take a few
moves, insertions and removals, so a lookup first tries the child after the last one
found, and the one after that. On a miss it scans the previous children, wrapping
around, until the scans have covered three times the list; only then does it index them
by segment. It also counts the children found, so once every previous child has been
claimed, a new child is known to be new without searching.

`Previous children cursor found scanned index`: `cursor` is where the next lookup
tries first, `found` how many previous children have been claimed, `scanned` how many
entries the scans have looked at, and `index` the positions by segment, once built.
}}
structural type Incremental.reconcile.PreviousChildren a g
  = EmptyPrevious
  | Previous [IncrementalNode a g] Nat Nat Nat (Optional (Map Key.Segment Nat))

{{ The previous children of an optional `ComputeRecord`, with nothing looked up yet. }}
Incremental.reconcile.PreviousChildren.of : Optional (ComputeRecord a g) -> PreviousChildren a g
Incremental.reconcile.PreviousChildren.of = cases
  None -> EmptyPrevious
  Some record ->
    children = ComputeRecord.children record
    if List.isEmpty children then EmptyPrevious
    else Previous children 0 0 0 None

{{
The previous child with `key`'s sibling segment, and the lookup state for the next
child. See {type PreviousChildren} for the order in which it looks.
}}
Incremental.reconcile.PreviousChildren.lookup :
  Key -> PreviousChildren a g -> (Optional (IncrementalNode a g), PreviousChildren a g)
Incremental.reconcile.PreviousChildren.lookup key = cases
  EmptyPrevious -> (None, EmptyPrevious)
  previous@(Previous children cursor found scanned index) ->
    use Nat * + < >=
    segment = childSegment key
    total = List.size children
    matchesAt position =
      match List.at position children with
        Some node | childSegment (IncrementalNode.key node) === segment -> Some node
        _ -> None
    claim position node scanned' index' =
      (Some node, Previous children (position + 1) (found + 1) scanned' index')
    if found >= total then (None, previous)
    else
      match matchesAt cursor with
        Some node -> claim cursor node scanned index
        None ->
          match matchesAt (cursor + 1) with
            Some node -> claim (cursor + 1) node scanned index
            None ->
              match index with
                Some positions ->
                  match Map.get segment positions with
                    Some position ->
                      match List.at position children with
                        Some node -> claim position node scanned index
                        None -> (None, previous)
                    None -> (None, previous)
                None ->
                  if scanned < (total * 3) then
                    start = cursor + 2
                    scan step =
                      if step >= total then (None, total)
                      else
                        position = Nat.mod (start + step) total
                        match matchesAt position with
                          Some node -> (Some (position, node), step + 1)
                          None -> scan (step + 1)
                    match scan 0 with
                      (Some (position, node), steps) -> claim position node (scanned + steps) None
                      (None, steps) -> (None, Previous children cursor found (scanned + steps) None)
                  else
                    addPosition positions = cases
                      (node, position) ->
                        Map.insert (childSegment (IncrementalNode.key node)) position positions
                    positions = List.foldLeft addPosition Map.empty (List.indexed children)
                    Incremental.reconcile.PreviousChildren.lookup
                      key (Previous children cursor found scanned (Some positions))

{{ The previous child `ComputeRecord` with `key`'s sibling segment, and the lookup state for the next child. }}
Incremental.reconcile.PreviousChildren.lookupComputeRecord :
  Key -> PreviousChildren a g -> (Optional (ComputeRecord a g), PreviousChildren a g)
Incremental.reconcile.PreviousChildren.lookupComputeRecord key records =
  (node, records') = PreviousChildren.lookup key records
  record = match node with
    Some (ComputeChild _ record) -> Some record
    Some (DetachedChild _ record) -> Some record
    _ -> None
  (record, records')

{{ The previous child `CellRecord` with `key`'s sibling segment, and the lookup state for the next child. }}
Incremental.reconcile.PreviousChildren.lookupCellRecord :
  Key -> PreviousChildren a g -> (Optional (CellRecord s m g), PreviousChildren a g)
Incremental.reconcile.PreviousChildren.lookupCellRecord key records =
  (node, records') = PreviousChildren.lookup key records
  record = match node with
    Some (CellChild _ anyRecord) -> Some (unsafeExtract anyRecord)
    _ -> None
  (record, records')

{{ Ability handler for `rerunExisting` when reconciling a computation against `previousChildren`. }}
Incremental.reconcile.handler : Location -> PreviousChildren a g -> [Message] -> KeyState -> [IncrementalNode a g] -> Request {g, Incremental a g} a ->{g, Stream (Delta a)} (a, [IncrementalNode a g])
Incremental.reconcile.handler location previousChildren messages keyState siblings = cases
  { compute keyHint body' -> resume } ->
    use List :+
    (key', keyState') = nextKey keyHint keyState
    (previous, previousChildren') = previousChildren |> lookupComputeRecord key'
    record' = Incremental.reconcile.reconcileCompute location key' messages previous body'
    child' = forCompute key' record'
    handle resume (ComputeRecord.result record') with Incremental.reconcile.handler (After key') previousChildren' messages keyState' (siblings :+ child')
  { compute_ keyHint body' -> resume } ->
    use List :+
    (key', keyState') = nextKey keyHint keyState
    (previous, previousChildren') = previousChildren |> lookupComputeRecord key'
    record' = Incremental.reconcile.reconcileCompute location key' messages previous body'
    handle resume () with Incremental.reconcile.handler (After key') previousChildren' messages keyState' (siblings :+ DetachedChild key' record')
  { cell keyHint cell' -> resume } ->
    use List :+
    (key', keyState') = nextKey keyHint keyState
    (previous, previousChildren') = previousChildren |> lookupCellRecord key'
    (result', child') = reconcileCell key' messages previous cell'
    handle resume result' with Incremental.reconcile.handler location previousChildren' messages keyState' (siblings :+ child')
  { value } -> (value, siblings)

{{
Looks up each key of `new` among previous children keyed `old`, in order, as one re-run
does: every lookup must find exactly the previous child with that key, whether it sits
where it was, moved, or is new, including once the lookups have fallen back to an index.
}}
tests.previousChildrenLookup : [Result]
tests.previousChildrenLookup =
  use List ++ +: :+
  keyOf n = Key [Key.Segment.Untagged n]
  numberOf = cases
    Key [Key.Segment.Untagged n] -> Some n
    _ -> None
  lookups : [Nat] -> [Nat] -> [Optional Nat]
  lookups old new =
    nodes : [IncrementalNode Nat {}]
    nodes = List.map (n -> CellChild (keyOf n) (Any n)) old
    go previous acc = cases
      [] -> acc
      n +: rest ->
        (found, previous') = PreviousChildren.lookup (keyOf n) previous
        go previous' (acc :+ Optional.flatMap (node -> numberOf (IncrementalNode.key node)) found) rest
    go (PreviousChildren.of (Some (ComputeRecord (do 0) 0 nodes))) [] new
  expected old new = List.map (n -> if List.contains n old then Some n else None) new
  old = Nat.range 0 50
  orders =
    [ old
    , [0, 48] ++ Nat.range 2 48 ++ [1, 49]
    , Nat.range 0 9 ++ Nat.range 10 50
    , Nat.range 0 20 ++ [100, 101] ++ Nat.range 20 50
    , List.reverse old
    , Nat.range 100 150
    , old ++ Nat.range 100 120
    , [49, 200] ++ Nat.range 0 49
    , []
    ]
  check (List.all (new -> lookups old new === expected old new) orders)

ReleaseNotes : Doc
ReleaseNotes =
  {{
  * Rename internal {type Cell} functions to be unique in more contexts.
  * 2026-10-29: re-running a computation looks its previous children up by
    position first, and indexes them only after a few misses, instead of
    building a map of all of them on every run. A two-row swap in a
    1,000-child list takes about a quarter less time, a removal about an
    eighth less, and clearing 10,000 children about an eighth less.
  }}

{{
Allocates the next child `Key` for `hint` within the current parent computation. A tag
seen for the first time among these siblings, the usual case for a keyed list, takes
one pass over the tag counts ({Map.insertIfMissing}); only a repeated tag takes a second.
}}
Incremental.reconcile.KeyState.nextKey : Optional k -> KeyState -> (Key, KeyState)
Incremental.reconcile.KeyState.nextKey hint = cases
  KeyState ancestors untaggedCount taggedCounts ->
    use List :+
    use Nat +
    match hint with
      None ->
        segment = Key.Segment.Untagged untaggedCount
        (Key (ancestors :+ segment), KeyState ancestors (untaggedCount + 1) taggedCounts)
      Some rawHint ->
        anyTag = Any rawHint
        match Map.insertIfMissing anyTag (do 1) taggedCounts with
          (taggedCounts', Right _) ->
            (Key (ancestors :+ Key.Segment.Tagged 0 anyTag), KeyState ancestors untaggedCount taggedCounts')
          (_, Left index) ->
            taggedCounts' = Map.insert anyTag (index + 1) taggedCounts
            (Key (ancestors :+ Key.Segment.Tagged index anyTag), KeyState ancestors untaggedCount taggedCounts')
