#!/usr/bin/env nu

use std/assert

# Writes the scaling benchmark's app in both languages:
# `nu bench/frontend-wasm/gen-cards.nu <count> [--edit]`.
#
# The app is `count` small stateful cards (a heading, a paragraph, a toggle
# that shows a detail line, and a click count), twenty to a page, every page
# drawn at once. The two copies say the same thing card for card:
#
# - Rust: `leptos/cards/src/generated.rs`, the `bench-cards` crate's body
#   (git-ignored; the crate is the Leptos half of the comparison).
# - Unison: `target/unison/frontend-bench/cards-<count>.u`, under
#   `bench.cards.s<count>`, plus an edited copy of the UI under `edited` that
#   differs only in card 7's paragraph, and the build entries
#   (`build`, `buildEdited`, `buildIncremental`) the benchmark compiles.
#
# `--edit` writes the Rust with card 7's paragraph changed, which is the
# one-line edit the Rust rebuild is timed on; the Unison file always carries
# both, because warp's incremental build compares two UIs in one process.
#
# `nu bench/frontend-wasm/gen-cards.nu self-test` runs its tests.

# Cards drawn on one page.
const CARDS_PER_PAGE = 20

# The card whose paragraph the one-line edit changes.
const EDITED_CARD = 7

# The paragraph a card shows, edited or not.
export def card-body [index: int, edited: bool] {
    let words = [alpha bravo charlie delta echo foxtrot golf hotel india juliet]
    let tail = 0..4 | each {|offset| $words | get (($index + $offset) mod ($words | length)) } | str join " "
    let lead = if $edited { "Edited body text" } else { "Body text" }
    $"($lead) for card ($index): ($tail)."
}

# The pages, as lists of card indices.
export def pages [count: int] {
    0..<$count | each {|index| $index } | chunks $CARDS_PER_PAGE
}

def rust-card [index: int, edited: bool] {
    let body = card-body $index ($edited and $index == $EDITED_CARD)
    rust-card-drawing $index $"<p>\"($body)\"</p>"
}

# A Rust card whose paragraph is drawn by `paragraph`.
def rust-card-drawing [index: int, paragraph: string] {
    $"#[component]
fn Card($index)\(\) -> impl IntoView {
    let \(open, set_open\) = signal\(false\);
    let \(count, set_count\) = signal\(0u64\);
    view! {
        <section class=\"card\" id=\"card-($index)\">
            <h2>\"Card ($index)\"</h2>
            ($paragraph)
            <button
                class=\"toggle\"
                on:click=move |_| {
                    set_open.update\(|open| *open = !*open\);
                    set_count.update\(|count| *count += 1\);
                }
            >
                {move || if open.get\(\) { \"Close\" } else { \"Open\" }}
            </button>
            <span class=\"count\">{move || count.get\(\).to_string\(\)}</span>
            <Show when=move || open.get\(\)>
                <p class=\"details\">\"Details for card ($index)\"</p>
            </Show>
        </section>
    }
}
"
}

# The Rust body of the `bench-cards` crate.
export def rust-source [count: int, edited: bool] {
    let cards = 0..<$count | each {|index| rust-card $index $edited }
    rust-app $count $cards $"edited: ($edited)"
}

# The crate body around `cards`: the pages, the app and the header.
def rust-app [count: int, cards: list<string>, note: string] {
    let page_list = pages $count | enumerate
    let page_defs = $page_list | each {|page|
        let children = $page.item | each {|index| $"            <Card($index) />" } | str join "\n"
        $"#[component]\nfn Page($page.index)\(\) -> impl IntoView {\n    view! {\n        <div class=\"page\">\n($children)\n        </div>\n    }\n}\n"
    }
    let app_children = $page_list | each {|page| $"            <Page($page.index) />" } | str join "\n"
    let app = $"#[component]\npub fn App\(\) -> impl IntoView {\n    view! {\n        <main id=\"app\">\n($app_children)\n        </main>\n    }\n}\n"
    [$"// Generated by bench/frontend-wasm/gen-cards.nu \(($count) cards, ($note)\); do not edit.\n"
        "use leptos::prelude::*;\n" ...$cards ...$page_defs $app] | str join "\n"
}

# One Unison card, `<ns>.card<index>`, whose paragraph reads `body`.
export def unison-card [ns: string, index: int, body: string] {
    unison-card-drawing $ns $index $"p [] do text \"($body)\""
}

# A Unison card whose paragraph is drawn by the statement `paragraph`.
def unison-card-drawing [ns: string, index: int, paragraph: string] {
    $"($ns).card($index) : '{Render {}} \(\)
($ns).card($index) = do
  use Render text
  \(state, updateCard\) = useState do \(false, 0\)
  \(open, count\) = state
  section [class \"card\", attr.id \"card-($index)\"] do
    h2 [] do text \"Card ($index)\"
    ($paragraph)
    button [class \"toggle\", onClick do updateCard \(cases \(isOpen, clicks\) -> \(Boolean.not isOpen, clicks Nat.+ 1\)\)] do
      text \(if open then \"Close\" else \"Open\"\)
    span [class \"count\"] do text \(Nat.toText count\)
    when open do p [class \"details\"] do text \"Details for card ($index)\"
"
}

def unison-page [ns: string, page_ns: string, card_ns: string, index: int, cards: list<int>] {
    let calls = $cards | each {|card| $"    ($card_ns).card($card)\(\)" } | str join "\n"
    $"($page_ns).page($index) : '{Render {}} \(\)\n($page_ns).page($index) = do\n  el.div [class \"page\"] do\n($calls)\n"
}

def unison-ui [ns: string, page_ns: string, page_count: int] {
    let calls = 0..<$page_count | each {|page| $"    ($page_ns).page($page)\(\)" } | str join "\n"
    $"($ns).ui : '{Render {}} \(\)\n($ns).ui = do\n  el.main [attr.id \"app\"] do\n($calls)\n"
}

# The Unison file for `count` cards: the UI, its edited copy and their build entries.
export def unison-source [count: int] {
    let ns = $"bench.cards.s($count)"
    let edited = $"($ns).edited"
    let page_list = pages $count | enumerate
    let cards = 0..<$count | each {|index| unison-card $ns $index (card-body $index false) }
    let page_defs = $page_list | each {|page| unison-page $ns $ns $ns $page.index $page.item }
    # The edited copy redefines only what the edit reaches: card 7, its page and the UI.
    let edited_page = $EDITED_CARD // $CARDS_PER_PAGE
    let edited_cards = $page_list | get $edited_page | get item | each {|index|
        if $index == $EDITED_CARD { $"($edited).card($index)" } else { $"($ns).card($index)" }
    }
    let edited_page_calls = $edited_cards | each {|card| $"    ($card)\(\)" } | str join "\n"
    let edited_defs = [
        (unison-card $edited $EDITED_CARD (card-body $EDITED_CARD true))
        $"($edited).page($edited_page) : '{Render {}} \(\)\n($edited).page($edited_page) = do\n  el.div [class \"page\"] do\n($edited_page_calls)\n"
        ($"($edited).ui : '{Render {}} \(\)\n($edited).ui = do\n  el.main [attr.id \"app\"] do\n" + (0..<($page_list | length) | each {|page|
            if $page == $edited_page { $"    ($edited).page($page)\(\)" } else { $"    ($ns).page($page)\(\)" }
        } | str join "\n") + "\n")
    ]
    let builds = [
        $"($ns).build : '{IO, Exception} \(\)\n($ns).build = bench.build.run \"cards-($count)\" ($ns).ui\n"
        $"($ns).buildEdited : '{IO, Exception} \(\)\n($ns).buildEdited = bench.build.run \"cards-($count)-edited\" ($edited).ui\n"
        $"($ns).buildIncremental : '{IO, Exception} \(\)\n($ns).buildIncremental = bench.build.runIncremental \"cards-($count)\" ($ns).ui ($edited).ui\n"
    ]
    [$"-- Generated by bench/frontend-wasm/gen-cards.nu \(($count) cards\); load into the bench codebase.\n"
        ...$cards ...$page_defs (unison-ui $ns $ns ($page_list | length)) ...$edited_defs ...$builds] | str join "\n"
}

# The hub variant (docs/Gaps.md, "An edit to a widely used definition"): the
# same cards, except that each draws its paragraph through one shared
# `paragraph` helper, whose text starts with `prefix`. An edit to the helper
# reaches every card, page and the UI; an edit to a card reaches one card, its
# page and the UI. `bodies` holds the paragraphs edited so far, by card.
export def hub-body [bodies: record, index: int] {
    $bodies | get --optional ($index | into string) | default (card-body $index false)
}

# The `bench-cards` crate's body for the hub variant.
export def rust-hub-source [count: int, prefix: string, bodies: record] {
    let paragraph = $"#[component]\nfn Paragraph\(text: &'static str\) -> impl IntoView {\n    view! { <p>\"($prefix)\"{text}</p> }\n}\n"
    let cards = 0..<$count | each {|index| rust-card-drawing $index $"<Paragraph text=\"(hub-body $bodies $index)\" />" }
    rust-app $count [$paragraph ...$cards] $"hub, prefix \"($prefix)\""
}

# The hub variant's shared helper.
export def unison-hub-paragraph [ns: string, prefix: string] {
    $"($ns).paragraph : Text ->{Render {}} \(\)\n($ns).paragraph body =\n  use Render text\n  use Text ++\n  p [] do text \(\"($prefix)\" ++ body\)\n"
}

# One hub-variant card, whose paragraph reads `prefix` then `body`.
export def unison-hub-card [ns: string, index: int, body: string] {
    unison-card-drawing $ns $index $"($ns).paragraph \"($body)\""
}

# The Unison file for the hub variant, under `bench.hub.s<count>`, with the dev
# loop's entries and a full build entry.
export def unison-hub-source [count: int] {
    let ns = $"bench.hub.s($count)"
    let page_list = pages $count | enumerate
    let cards = 0..<$count | each {|index| unison-hub-card $ns $index (card-body $index false) }
    let page_defs = $page_list | each {|page| unison-page $ns $ns $ns $page.index $page.item }
    let entries = [
        $"($ns).dev.base : '{IO, Exception} \(\)\n($ns).dev.base = bench.dev.base ($ns).ui\n"
        $"($ns).dev.delta : '{IO, Exception} \(\)\n($ns).dev.delta = bench.dev.delta ($ns).ui\n"
        $"($ns).build : '{IO, Exception} \(\)\n($ns).build = bench.build.run \"hub-($count)\" ($ns).ui\n"
    ]
    [$"-- Generated by bench/frontend-wasm/gen-cards.nu \(($count) cards, hub variant\); load into the bench codebase on @dfreeman/proscenium/devloop.\n"
        (unison-hub-paragraph $ns "") ...$cards ...$page_defs (unison-ui $ns $ns ($page_list | length)) ...$entries] | str join "\n"
}

def "main self-test" [] {
    assert equal (card-body 0 false) "Body text for card 0: alpha bravo charlie delta echo."
    assert equal (card-body 9 true) "Edited body text for card 9: juliet alpha bravo charlie delta."
    assert equal (pages 45 | length) 3
    assert equal (pages 45 | last) [40 41 42 43 44]
    let rust = rust-source 25 true
    assert ($rust | str contains "fn Card24()")
    assert ($rust | str contains "fn Page1()")
    assert ($rust | str contains "Edited body text for card 7")
    assert not ((rust-source 25 false) | str contains "Edited")
    let unison = unison-source 25
    assert ($unison | str contains "bench.cards.s25.edited.card7 :")
    assert ($unison | str contains "bench.cards.s25.edited.page0 :")
    assert ($unison | str contains "    bench.cards.s25.page1()")
    assert ($unison | str contains "    p [] do text \"Body text for card 3: delta echo foxtrot golf hotel.\"\n")
    let hub = unison-hub-source 25
    assert ($hub | str contains "bench.hub.s25.paragraph body =\n  use Render text\n  use Text ++\n  p [] do text (\"\" ++ body)\n")
    assert ($hub | str contains "    bench.hub.s25.paragraph \"Body text for card 3: delta echo foxtrot golf hotel.\"\n")
    assert ($hub | str contains "bench.hub.s25.dev.delta = bench.dev.delta bench.hub.s25.ui")
    assert equal (hub-body { "3": "x" } 3) "x"
    assert equal (hub-body {} 3) (card-body 3 false)
    let rust_hub = rust-hub-source 25 "Hub 2: " { "7": "Edit 1: seven" }
    assert ($rust_hub | str contains "view! { <p>\"Hub 2: \"{text}</p> }")
    assert ($rust_hub | str contains "<Paragraph text=\"Edit 1: seven\" />")
    assert ($rust_hub | str contains "<Paragraph text=\"Body text for card 8: india juliet alpha bravo charlie.\" />")
    print "gen-cards self-test: ok"
}

def main [
    count: int    # how many cards
    --edit        # write the Rust with card 7's paragraph edited
] {
    let here = $env.FILE_PWD
    let rust_path = $here | path join "leptos" "cards" "src" "generated.rs"
    rust-source $count $edit | save --force $rust_path
    let root = $here | path dirname | path dirname
    let unison_dir = $root | path join "target" "unison" "frontend-bench"
    mkdir $unison_dir
    let unison_path = $unison_dir | path join $"cards-($count).u"
    unison-source $count | save --force $unison_path
    print $"wrote ($rust_path) and ($unison_path)"
}
